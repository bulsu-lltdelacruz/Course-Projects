<?xml version="1.0" encoding="utf-8"?>
<!-- item_icon_option_locked.xml — Locked/unselected icon card (1x1 Ratio) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="5dp">

    <!-- Card — ConstraintLayout forces 1:1 ratio -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/iconCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_option_card_unselected">

        <!-- This helper forces the height to match the width -->
        <View
            android:id="@+id/ratioHelper"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Lock icon container centered inside -->
        <FrameLayout
            android:id="@+id/itemPicture"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_lock_wrap"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/lockIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lock"
                android:contentDescription="Locked" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Label -->
    <TextView
        android:id="@+id/iconLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dragon"
        android:textSize="11sp"
        android:textColor="@color/textMuted"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="6dp" />
</LinearLayout>
