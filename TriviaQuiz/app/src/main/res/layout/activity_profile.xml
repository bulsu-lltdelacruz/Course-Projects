<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/backgroundBase">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="15dp"
        android:layout_marginBottom="5dp"
        android:paddingHorizontal="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="100dp"
                android:layout_height="30dp">
                <ImageView
                    android:id="@+id/btnMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_burger"
                    app:tint="?attr/textPrimary"/>
            </LinearLayout>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Profile"
                android:textColor="?attr/textPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />
            <Space
                android:layout_width="100dp"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/ivProfileAvatar"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ic_coin" />
                <ImageView
                    android:id="@+id/ivProfileBorder"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"/>
            </FrameLayout>

            <TextView
                android:id="@+id/tvProfileName"
                style="@style/Text.Heading1"
                android:textColor="?attr/textPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="QuizMaster99" />

            <TextView
                android:id="@+id/tvProfileEmail"
                style="@style/Text.Subtitle"
                android:textColor="?attr/textSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="student@school.edu" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/CardStyle"
                    android:backgroundTint="?attr/cardSurface"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Games"
                        android:textColor="?attr/textSubtitle"
                        android:textStyle="bold"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/tvTotalQuizzes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="46"
                        android:textStyle="bold"
                        android:textColor="?attr/textPrimary"
                        android:textSize="20sp"/>
                </LinearLayout>

                <LinearLayout
                    style="@style/CardStyle"
                    android:backgroundTint="?attr/cardSurface"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Coins"
                        android:textColor="?attr/textSubtitle"
                        android:textStyle="bold"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/tvCoins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="880"
                        android:textStyle="bold"
                        android:textColor="@color/colorAccent"
                        android:textSize="20sp"/>
                </LinearLayout>

                <LinearLayout
                    style="@style/CardStyle"
                    android:backgroundTint="?attr/cardSurface"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Correct"
                        android:textColor="?attr/textSubtitle"
                        android:textStyle="bold"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/tvCorrectItems"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4"
                        android:textStyle="bold"
                        android:textColor="@color/colorPurple"
                        android:textSize="20sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="40dp"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/CardStyle"
                    android:backgroundTint="?attr/cardSurface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Rank"
                        android:textColor="?attr/textSubtitle"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textAlignment="textStart"/>
                    <TextView
                        android:id="@+id/tvRank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bronze"
                        android:textColor="@color/strokeRankBronze"
                        android:textStyle="bold"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/bg_rank_novice"
                        android:drawableStart="@drawable/ic_trophy"
                        android:drawablePadding="5dp"
                        android:drawableTint="@color/strokeRankBronze"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tvCurrentScore"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:textColor="?attr/textPrimary"
                            android:text="355 Points"/>
                        <TextView
                            android:id="@+id/tvTotalScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="?attr/textPrimary"
                            android:text="500 Points"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/strokeGray"
                        android:orientation="horizontal">
                        <View
                            android:id="@+id/viewProgressBar"
                            android:layout_width="0dp"
                            android:layout_weight="0.7"
                            android:layout_height="match_parent"
                            android:background="@drawable/loading_bar"
                            android:backgroundTint="@color/colorAccent"/>
                        <View
                            android:id="@+id/viewProgressBarTotal"
                            android:layout_width="0dp"
                            android:layout_weight="0.3"
                            android:background="@drawable/loading_bar"
                            android:layout_height="match_parent"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    style="@style/CardStyle"
                    android:backgroundTint="?attr/cardSurface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Equipped"
                        android:textColor="?attr/textSubtitle"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:layout_marginBottom="10dp"
                        android:textAlignment="textStart"/>
                    <LinearLayout
                        style="@style/CardStyle.Greyed"
                        android:backgroundTint="?attr/cardSurfaceGreyed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_margin="0dp">
                        <TextView
                            style="@style/Text.Subtitle"
                            android:textColor="?attr/textPrimary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Icon"/>
                        <TextView
                            android:id="@+id/tvEquippedIconValue"
                            style="@style/Text.Subtitle"
                            android:textColor="?attr/textPrimary"
                            android:textStyle="bold"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAlignment="textEnd"
                            android:text="What"/>
                    </LinearLayout>
                    <LinearLayout
                        style="@style/CardStyle.Greyed"
                        android:backgroundTint="?attr/cardSurfaceGreyed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="0dp"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/Text.Subtitle"
                            android:textColor="?attr/textPrimary"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Border"/>
                        <TextView
                            android:id="@+id/tvEquippedBorderValue"
                            style="@style/Text.Subtitle"
                            android:textColor="?attr/textPrimary"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Border"
                            android:textStyle="bold"
                            android:textAlignment="textEnd"/>
                    </LinearLayout>
                    <LinearLayout
                        style="@style/CardStyle.Greyed"
                        android:backgroundTint="?attr/cardSurfaceGreyed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="0dp"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/Text.Subtitle"
                            android:textColor="?attr/textPrimary"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Theme"/>
                        <TextView
                            android:id="@+id/tvEquippedThemeValue"
                            style="@style/Text.Subtitle"
                            android:textColor="?attr/textPrimary"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Default Light"
                            android:textStyle="bold"
                            android:textAlignment="textEnd"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnCustomize"
                style="@style/ButtonStyle.Primary"
                android:backgroundTint="@color/colorBlueProfile"
                android:drawableStart="@drawable/ic_customize"
                android:drawableTint="@color/surfaceWhite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Customize Appearance" />

            <Button
                android:id="@+id/btnLogout"
                style="@style/ButtonStyle.Primary"
                android:backgroundTint="@color/errorRed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Log Out" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>