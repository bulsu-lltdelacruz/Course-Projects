<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ButtonStyle" parent="Widget.AppCompat.Button" />
    <style name="Text" parent="android:Widget.TextView" />

    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:actionBarSize">80dp</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/backgroundBase</item>
    </style>

    <style name="Text.Heading1">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/textPrimary</item>
    </style>

    <style name="Text.Subtitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/textSubtitle</item>
    </style>

    <style name="CardStyle">
        <item name="android:background">@drawable/bg_card_white</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_margin">16dp</item>
    </style>
    <style name="CardStyle.Quiz">
    </style>
    <style name="CardStyle.Quiz.Correct">
        <item name="android:background">@drawable/bg_card_quiz_correct</item>
    </style>
    <style name="CardStyle.Quiz.Wrong">
        <item name="android:background">@drawable/bg_card_quiz_wrong</item>
    </style>
    <style name="CardStyle.Easy">
        <item name="android:background">@drawable/bg_card_easy</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_margin">16dp</item>

    </style>
    <style name="CardStyle.Medium">
        <item name="android:background">@drawable/bg_card_medium</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_margin">16dp</item>

    </style>
    <style name="CardStyle.Hard">
        <item name="android:background">@drawable/bg_card_hard</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_margin">16dp</item>

    </style>
    <style name="CardStyle.Greyed">
        <item name="android:background">@drawable/bg_card_gray</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_margin">16dp</item>

    </style>
    <style name="CardStyleShop">
        <item name="android:background">@drawable/bg_card_white_rounded</item>
        <item name="android:layout_marginHorizontal">2dp</item>
        <item name="android:paddingHorizontal">6dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">9dp</item>
    </style>
    <style name="CardStyleShop.Unselected">
        <item name="android:background">@drawable/bg_card_white_rounded</item>
    </style>
    <style name="CardStyleShop.Selected">
        <item name="android:background">@drawable/bg_card_black_rounded</item>
    </style>
    <style name="CardStyle.Difficulty">
    </style>

    <style name="CardStyle.Difficulty.Sub">
        <item name="android:background">@drawable/bg_option_card_unselected</item>
        <item name="android:padding">5dp</item>
        <item name="android:layout_margin">0dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="CardStyle.NoMargin">
        <item name="android:background">@drawable/bg_card_white</item>
    </style>

    <style name="ButtonStyle.Primary">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/surfaceWhite</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">16dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="TextStyle">
    </style>
    <style name="TextStyle.Outside">
        <item name="android:textColor">?attr/textPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="InputFieldStyle">
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:padding">16dp</item>
        <item name="android:textColor">?attr/textPrimary</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="circleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="Theme.AppCompat.Translucent" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- ── Light (default) ── -->
    <style name="Theme.TriviaQuiz.Light" parent="AppTheme">
        <item name="backgroundBase">@color/backgroundBase</item>
        <item name="cardSurface">@color/surfaceWhite</item>
        <item name="cardSurfaceGreyed">#DFE3E6</item>
        <item name="textPrimary">@color/textDark</item>
        <item name="textSubtitle">@color/textMuted</item>
        <item name="strokeColor">@color/strokeGray</item>
        <item name="buttonPrimary">@color/colorPrimary</item>
        <item name="inputField">#E2E8F0</item>
    </style>

    <style name="Theme.TriviaQuiz.Dark" parent="AppTheme">
        <item name="android:windowBackground">#121212</item>
        <item name="backgroundBase">#121212</item>
        <item name="cardSurface">#1E1E2E</item>
        <item name="cardSurfaceGreyed">#1B1B2A</item>
        <item name="textPrimary">#E0E0E0</item>
        <item name="textSubtitle">#9E9E9E</item>
        <item name="strokeColor">#2C2C3E</item>
        <item name="buttonPrimary">#BB86FC</item>
        <item name="colorPrimary">#1A1A2E</item>
        <item name="inputField">#40404E</item>
    </style>

    <style name="Theme.TriviaQuiz.Ocean" parent="AppTheme">
        <item name="android:windowBackground">#071E30</item>
        <item name="backgroundBase">#071E30</item>
        <item name="cardSurface">#0D2D45</item>
        <item name="cardSurfaceGreyed">#0B273E</item>
        <item name="textPrimary">#D0F0F7</item>
        <item name="textSubtitle">#7ABFD4</item>
        <item name="strokeColor">#1A4A6B</item>
        <item name="buttonPrimary">#00B4D8</item>
        <item name="colorPrimary">#0B3D5E</item>
        <item name="inputField">#1A3B52</item>
    </style>

    <style name="Theme.TriviaQuiz.Sunset" parent="AppTheme">
        <item name="android:windowBackground">#1A0A2E</item>
        <item name="backgroundBase">#1A0A2E</item>
        <item name="cardSurface">#2D1245</item>
        <item name="cardSurfaceGreyed">#291040</item>
        <!--<item name="textPrimary">#FFD6E0</item>
        <item name="textSubtitle">#E8A0BF</item>-->
        <item name="textPrimary">#FDEBEF</item>
        <item name="textSubtitle">#E9B1C9</item>
        <item name="strokeColor">#4A1A6B</item>
        <item name="buttonPrimary">#FF6B6B</item>
        <item name="colorPrimary">#7B2D8B</item>
        <item name="inputField">#402656</item>
    </style>

</resources>
