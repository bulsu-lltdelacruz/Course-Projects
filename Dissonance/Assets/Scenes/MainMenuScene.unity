  newGameIntro:
  - dialogue: ...
    photo: {fileID: 2800000, guid: 711a4e70b23d07a4b8de67ca9b58f647, type: 3}
  - dialogue: ......
    photo: {fileID: 2800000, guid: 711a4e70b23d07a4b8de67ca9b58f647, type: 3}
  - dialogue: .........
    photo: {fileID: 2800000, guid: c7e104834677b7b42871136f3098cf2b, type: 3}
  - dialogue: ..........
    photo: {fileID: 2800000, guid: ef2407763ace8ce47a3987ed445d47f1, type: 3}
  - dialogue: My head hurts...
    photo: {fileID: 2800000, guid: ef2407763ace8ce47a3987ed445d47f1, type: 3}
  - dialogue: This... Wait. I think... There's something I'm forgetting...
    photo: {fileID: 2800000, guid: b9dca4efcf4c65647ac82e609c5b56a2, type: 3}
  - dialogue: That chip probably came out of my head...
    photo: {fileID: 2800000, guid: b9dca4efcf4c65647ac82e609c5b56a2, type: 3}
  - dialogue: ...
    photo: {fileID: 2800000, guid: cd3501f995dfdcb4a93a2f0636c0f4e4, type: 3}
  - dialogue: This person...
    photo: {fileID: 2800000, guid: cd3501f995dfdcb4a93a2f0636c0f4e4, type: 3}
  - dialogue: '"Remember..."'
    photo: {fileID: 2800000, guid: cd3501f995dfdcb4a93a2f0636c0f4e4, type: 3}
  - dialogue: '"Remember the promise that we made."'
    photo: {fileID: 2800000, guid: cd3501f995dfdcb4a93a2f0636c0f4e4, type: 3}
  - dialogue: '"Don''t let them control you."'
    photo: {fileID: 2800000, guid: 711a4e70b23d07a4b8de67ca9b58f647, type: 3}
  - dialogue: ...
    photo: {fileID: 2800000, guid: 711a4e70b23d07a4b8de67ca9b58f647, type: 3}
