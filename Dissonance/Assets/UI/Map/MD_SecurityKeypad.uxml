                <ui:VisualElement name="logo" style="flex-grow: 1; position: absolute; top: 0; left: 0; right: auto; bottom: auto; background-image: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=-1304905567622442630&amp;guid=ed2aba92da6edc747bae99ec8e320aab&amp;type=3#arrow-down@2x&quot;); width: 50px; height: 50px;"/>
                <ui:Label text="123434" name="screen-text" style="align-items: stretch; align-self: auto; align-content: auto; justify-content: flex-start; font-size: 75px; border-left-width: 40px; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Packages/com.unity.render-pipelines.core/Runtime/Debugging/Prefabs/Fonts/PerfectDOSVGA437.ttf?fileID=12800000&amp;guid=74a5091d8707f334b9a5c31ef71a64ba&amp;type=3#PerfectDOSVGA437&quot;);"/>
            </ui:VisualElement>
            <ui:VisualElement name="keypad" style="flex-grow: 1; padding-left: 18px; padding-right: 18px; justify-content: center;">
