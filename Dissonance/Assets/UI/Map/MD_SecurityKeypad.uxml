<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Map/MD_SecurityKeypad.uss?fileID=7433441132597879392&amp;guid=d835fba863da9b74b860784ab9fe0d1e&amp;type=3#MD_SecurityKeypad"/>
    <ui:VisualElement name="parent" style="flex-grow: 1; justify-content: center; background-color: rgba(0, 0, 0, 0.8); display: none;">
        <ui:VisualElement name="keypad" style="flex-grow: 1; background-image: none; width: 30%; height: 90%; max-height: 90%; align-self: center; align-content: flex-start; align-items: stretch; justify-content: flex-start; background-color: rgb(200, 205, 207); border-top-width: 20px; border-right-width: 20px; border-bottom-width: 20px; border-left-width: 20px; border-left-color: rgb(138, 144, 147); border-right-color: rgb(138, 143, 147); border-top-color: rgb(158, 164, 168); border-bottom-color: rgb(158, 164, 168);">
