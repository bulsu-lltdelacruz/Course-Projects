VisualElement {
}

#parent {
    background-color: rgba(212, 212, 212, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.itemSlotParent {
    width: 30%;
    height: auto;
    min-height: auto;
    max-height: 47%;
    padding-top: 0;
    justify-content: flex-start;
    align-items: center;
    flex-direction: column;
    align-content: flex-start;
    flex-wrap: nowrap;
    flex-shrink: 0;
    flex-grow: 0;
    aspect-ratio: 1;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(171, 171, 171);
    border-right-color: rgb(171, 171, 171);
    border-top-color: rgb(171, 171, 171);
    border-bottom-color: rgb(171, 171, 171);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    background-color: rgba(255, 255, 255, 0);
    max-width: 30%;
}

.itemSlot {
    max-width: 100%;
    max-height: 100%;
    min-width: 100%;
    min-height: 100%;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    padding-top: 0;
    height: 100%;
    width: 100%;
    -unity-background-scale-mode: stretch-to-fill;
    background-position-x: center;
    transition-property: all;
    transition-duration: 0s;
    transition-timing-function: ease;
    transition-delay: 0s;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    padding-bottom: 0;
    aspect-ratio: 1;
    background-color: rgba(195, 195, 195, 0);
    background-image: none;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-size: 85% 85%;
}

.itemSlotFilter {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Render_Textures/slot.jpg?fileID=2800000&guid=4479ef2ebc77dfe4384de4e77b021d3e&type=3#slot");
    -unity-background-image-tint-color: rgba(197, 197, 197, 0.01);
}

.popUp {
    background-color: rgba(224, 224, 224, 0);
    min-width: 100%;
    min-height: auto;
    flex-shrink: 0;
    align-self: center;
    max-width: 100%;
    width: 100%;
    position: absolute;
    translate: 0 0 100px;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.popUpButton {
    width: 100%;
    height: 0%;
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 10px;
    padding-right: 0;
    padding-bottom: 10px;
    padding-left: 0;
    background-color: rgba(28, 28, 28, 0.75);
    color: rgb(205, 205, 205);
    align-self: auto;
    max-width: 100%;
    min-width: 100%;
    min-height: 33%;
    max-height: 33%;
    border-top-width: -4px;
    border-right-width: -4px;
    border-bottom-width: -4px;
    border-left-width: -4px;
    font-size: 22px;
    -unity-font-definition: url("project://database/Assets/Fonts/Montserrat-SemiBold.ttf?fileID=12800000&guid=39c8e013ef61ee04e85b7bb342aa5b8e&type=3#Montserrat-SemiBold");
}

.itemPicture {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    width: 80%;
    height: 80%;
    max-height: 80%;
    max-width: 80%;
    border-bottom-width: 0;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
    border-bottom-right-radius: 1px;
    border-bottom-left-radius: 1px;
    background-image: url("project://database/Assets/_Sprites/Inventory/inventory_img_MW%20screwdriver.png?fileID=2800000&guid=b54203f1e50a272489ef8bad32bccb54&type=3#inventory_img_MW screwdriver");
    background-repeat: no-repeat no-repeat;
    -unity-background-scale-mode: scale-to-fit;
    margin-top: 15px;
    margin-bottom: 15px;
}

.itemDescription {
    width: 80%;
    height: 80%;
    max-height: 80%;
    max-width: 80%;
    align-items: center;
    justify-content: center;
    -unity-font-definition: url("project://database/Assets/Fonts/Montserrat-SemiBold.ttf?fileID=12800000&guid=39c8e013ef61ee04e85b7bb342aa5b8e&type=3#Montserrat-SemiBold");
}

.descriptionText {
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    width: 100%;
    height: 100px;
    min-height: 100%;
    min-width: 100%;
    max-width: 100%;
    max-height: 100%;
    font-size: 25%;
    white-space: normal;
    -unity-font-style: normal;
}

.popUpButton:hover {
    width: 100%;
    height: 0%;
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 10px;
    padding-right: 0;
    padding-bottom: 10px;
    padding-left: 0;
    background-color: rgba(103, 103, 103, 0.75);
    color: rgb(205, 205, 205);
    align-self: auto;
    max-width: 100%;
    min-width: 100%;
    min-height: 33%;
    max-height: 33%;
}

.border {
    border-top-width: 20px;
    border-right-width: 20px;
    border-bottom-width: 20px;
    border-left-width: 20px;
    border-left-color: rgb(123, 123, 125);
    border-right-color: rgb(124, 124, 126);
    border-bottom-color: rgb(46, 46, 46);
    border-top-color: rgb(46, 46, 46);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
}

.parent-close {
    translate: 0 -105%;
}

.inventory-close {
    translate: -50% 0%;
}

.header-label {
    width: 50%;
    -unity-text-align: upper-center;
    white-space: normal;
    font-size: 25px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-top: 0;
}

.crt {
    background-image: url("project://database/Assets/Render_Textures/UI/horizontal-stripe.jpg?fileID=2800000&guid=1244da132199ebe4698c46a9327c2f57&type=3#horizontal-stripe");
    background-color: rgb(23, 23, 25);
    -unity-background-image-tint-color: rgb(65, 65, 65);
    -unity-background-scale-mode: scale-and-crop;
    -unity-slice-type: sliced;
    background-position-x: center;
    background-position-y: center;
    opacity: 0.15;
}

.video-player {
    background-image: url("project://database/Assets/Render_Textures/VideoRender.renderTexture?fileID=8400000&guid=86cd1f5f9b712864a89443670a4b8904&type=2#VideoRender");
}

.itemBoxSlotParent {
    height: 100px;
    flex-direction: column;
}

.itemBoxSlot {
    flex-direction: row;
    height: 100px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    margin-left: 35px;
    margin-right: 35px;
}

.itemBoxImage {
    aspect-ratio: auto;
    height: auto;
    background-image: url("project://database/Assets/_Sprites/Inventory/inventory_img_MW%20hallway%20east%20key.png?fileID=2800000&guid=119e1f3da5d855942b02f15b371bff26&type=3#inventory_img_MW hallway east key");
    background-position-x: center;
    background-position-y: center;
    -unity-background-scale-mode: scale-to-fit;
    -unity-slice-type: sliced;
    align-content: flex-start;
    align-self: auto;
    justify-content: flex-start;
    align-items: stretch;
    flex-direction: column;
    width: 21%;
    max-width: 21%;
}

.itemBoxText {
    width: 75%;
    min-width: 75%;
    max-width: 75%;
    color: rgb(255, 255, 255);
    -unity-text-auto-size: none;
    font-size: 40px;
    -unity-text-align: middle-right;
    padding-right: 62px;
}

.itemBoxSlot:hover {
    flex-direction: row;
    height: 100px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    margin-left: 35px;
    margin-right: 35px;
    background-color: rgb(41, 41, 41);
}

.amountLabel {
    color: rgb(255, 255, 255);
    position: absolute;
    top: auto;
    left: 0;
    right: 0;
    bottom: 0;
    padding-left: 10px;
    padding-bottom: 10px;
}

.map-itself-absolute {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.single-door-horizontal {
    height: 15px;
    width: 40px;
    max-width: 40px;
    max-height: 15px;
    position: absolute;
    visibility: visible;
}

.single-door-vertical {
    width: 15px;
    height: 40px;
    max-height: 40px;
}

.double-door-horizontal {
    width: 80px;
    max-width: 134px;
    min-width: 80px;
}

.unlocked {
    background-color: rgb(0, 78, 255);
}

.locked {
    background-color: rgb(168, 25, 25);
}

.notInteracted {
    background-color: rgb(152, 152, 152);
}

.unopenable {
    background-color: rgb(0, 0, 0);
}

.inArea {
    -unity-background-image-tint-color: rgb(147, 158, 224);
}

.save-room-text {
    position: absolute;
    color: rgb(8, 178, 0);
    -unity-font-definition: url("project://database/Assets/Fonts/Montserrat-SemiBold.ttf?fileID=12800000&guid=39c8e013ef61ee04e85b7bb342aa5b8e&type=3#Montserrat-SemiBold");
    -unity-font-style: bold-and-italic;
    -unity-text-outline-color: rgb(128, 128, 128);
    -unity-text-outline-width: 0;
    font-size: 29px;
}
