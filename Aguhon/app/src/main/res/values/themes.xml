<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Aguhan" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:layout_margin">0dp</item>
    </style>
    <style name="Base.Theme.Aguhan.Background" parent="Theme.Material3.DayNight.NoActionBar">

    </style>
    <style name="Base.Theme.Aguhan.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/cardFocused</item>
    </style>
    <style name="Base.Theme.Aguhan.Font.Header" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textSize">36sp</item>
        <item name="android:textAlignment">center</item>
    </style>
    <style name="Base.Theme.Aguhan.Font.Menu" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textAlignment">center</item>
    </style>
    <style name="Base.Theme.Aguhan.Font.SubHeader" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textAlignment">center</item>
    </style>
    <style name="Base.Theme.Aguhan.Font.CardHeader" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAlignment">textStart</item>
    </style>
    <style name="Base.Theme.Aguhan.Font.EditText" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColorHint">#6b7280</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="Base.Theme.Aguhan.Font.Anchor" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/accent</item>
    </style>
    <style name="Base.Theme.Aguhan.Font.Label" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_marginTop">13dp</item>
        <item name="android:layout_marginBottom">5dp</item>
    </style>
    <style name="Base.Theme.Aguhan.Font.Button" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="background">@drawable/bg_button</item>
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textSize">20sp</item>
        <item name="backgroundTint">@color/accent</item>
    </style>
    <style name="Base.Theme.Aguhan.Font.CancelButton" parent="Theme.Material3.DayNight.NoActionBar">
        <!--<item name="background">@drawable/bg_cancel</item>-->
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textSize">20sp</item>
        <item name="backgroundTint">@color/transparent</item>
    </style>
    <style name="Base.Theme.Aguhan.Font.SmallCardHeader" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="background">@drawable/bg_button</item>
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/accent</item>
    </style>
    <style name="Base.Theme.Aguhan.Font.SmallCardText" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="background">@drawable/bg_button</item>
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textColor">#5D5C6A</item>
    </style>
    <style name="Base.Theme.Aguhan.Card" parent="Theme.Material3.DayNight.NoActionBar">

    </style>

    <style name="Theme.Aguhon" parent="Base.Theme.Aguhan" />

</resources>